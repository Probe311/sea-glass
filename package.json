{
  "name": "seaglass",
  "private": true,
  "version": "0.2.1",
  "description": "Sea Glass - frosted sea-glass design system (translucency, frost, refraction, rim, glow, grain, tint).",
  "license": "MIT",
  "author": "Julien Vaissier (Probe311)",
  "homepage": "https://github.com/Probe311/sea-glass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Probe311/sea-glass.git"
  },
  "bugs": {
    "url": "https://github.com/Probe311/sea-glass/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --if-present build",
    "lint": "eslint . && stylelint \"packages/css/src/**/*.css\" && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"packages/css/src/**/*.css\" --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "check:demo": "node ./scripts/check-demo-js.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "preflight": "pnpm check:demo && pnpm typecheck && pnpm build && pnpm test",
    "preflight:full": "pnpm check",
    "storybook": "pnpm --filter @sea-glass/storybook storybook",
    "build:storybook": "pnpm --filter @sea-glass/storybook build:storybook",
    "build:logo": "node ./scripts/build-logo.mjs",
    "sync:version": "node ./scripts/sync-version.mjs",
    "sync:demo": "node ./scripts/sync-demo.mjs",
    "demo:prepare": "pnpm build && pnpm sync:version && pnpm sync:demo",
    "icons:galet": "node ./scripts/inject-galet-sprite.mjs",
    "release:dry": "node ./scripts/release-dry.mjs",
    "prepare": "husky || true && node ./scripts/sync-version.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --no-warn-ignored",
    "packages/css/src/**/*.css": "stylelint --fix",
    "*.{js,mjs,cjs,ts,tsx,css,md,json,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "style-dictionary",
      "@bundled-es-modules/glob"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/poppins": "^5.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
