{
  "name": "@sea-glass/react",
  "version": "0.1.0",
  "description": "Sea Glass React components — glass material UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@sea-glass/css": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Probe311/sea-glass.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "design-system",
    "glassmorphism",
    "sea-glass",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
