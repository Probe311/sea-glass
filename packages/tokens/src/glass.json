{
  "blur": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "glass": {
    "alpha-ground": {
      "$type": "number",
      "$value": 0.42,
      "$extensions": { "seaglass": { "dark": 0.1 } }
    },
    "alpha-scene": {
      "$type": "number",
      "$value": 0.08,
      "$extensions": { "seaglass": { "dark": 0.1 } }
    },
    "alpha-text": {
      "$type": "number",
      "$value": 0.82,
      "$extensions": { "seaglass": { "dark": 0.18 } }
    },
    "spec": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.5)",
      "$extensions": { "seaglass": { "dark": "rgba(255, 255, 255, 0.24)" } }
    },
    "sheen": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.22)",
      "$extensions": { "seaglass": { "dark": "rgba(255, 255, 255, 0.08)" } }
    },
    "lit": {
      "$type": "number",
      "$value": 0.95,
      "$extensions": { "seaglass": { "dark": 0.6 } }
    },
    "caustic-edge": {
      "$type": "number",
      "$value": 0.7,
      "$extensions": { "seaglass": { "dark": 0.4 } }
    },
    "caustic": {
      "$type": "number",
      "$value": 0.55,
      "$extensions": { "seaglass": { "dark": 0.3 } }
    },
    "carved-lo": {
      "$type": "color",
      "$value": "rgba(34, 92, 78, 0.36)",
      "$extensions": { "seaglass": { "dark": "rgba(0, 0, 0, 0.55)" } }
    },
    "carved-hi": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.95)",
      "$extensions": { "seaglass": { "dark": "rgba(255, 255, 255, 0.14)" } }
    },
    "well-a": {
      "$type": "number",
      "$value": 0.5,
      "$extensions": { "seaglass": { "dark": 0.05 } }
    },
    "well-b": {
      "$type": "number",
      "$value": 0.85,
      "$extensions": { "seaglass": { "dark": 0.1 } }
    },
    "sparkle": {
      "$type": "number",
      "$value": 0.22,
      "$extensions": { "seaglass": { "dark": 0.16 } }
    }
  }
}
