{
  "blur": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "20px" }
  },
  "glass": {
    "alpha-ground": {
      "$type": "number",
      "$value": 0.74,
      "$description": "Translucency on a flat ground",
      "$extensions": { "seaglass": { "dark": 0.08 } }
    },
    "alpha-scene": {
      "$type": "number",
      "$value": 0.26,
      "$description": "Translucency over a coloured scene",
      "$extensions": { "seaglass": { "dark": 0.12 } }
    },
    "alpha-text": {
      "$type": "number",
      "$value": 0.88,
      "$description": "Opacity floor when text sits on glass over a photograph"
    },
    "alpha-reduce": {
      "$type": "number",
      "$value": 0.96,
      "$description": "Opaque fallback for prefers-reduced-transparency"
    },
    "lit": {
      "$type": "number",
      "$value": 0.95,
      "$extensions": { "seaglass": { "dark": 0.6 } }
    },
    "caustic-edge": {
      "$type": "dimension",
      "$value": "70%",
      "$extensions": { "seaglass": { "dark": "40%" } }
    },
    "caustic": {
      "$type": "dimension",
      "$value": "55%",
      "$extensions": { "seaglass": { "dark": "30%" } }
    },
    "spec": {
      "$type": "color",
      "$value": "#FFFFFF80",
      "$extensions": { "seaglass": { "dark": "#FFFFFF3D" } }
    },
    "sheen": {
      "$type": "color",
      "$value": "#FFFFFF38",
      "$extensions": { "seaglass": { "dark": "#FFFFFF14" } }
    },
    "sparkle": {
      "$type": "number",
      "$value": 0.32,
      "$description": "Film grain opacity",
      "$extensions": { "seaglass": { "dark": 0.1 } }
    },
    "well-a": {
      "$type": "number",
      "$value": 0.5,
      "$extensions": { "seaglass": { "dark": 0.05 } }
    },
    "well-b": {
      "$type": "number",
      "$value": 0.85,
      "$extensions": { "seaglass": { "dark": 0.1 } }
    },
    "carved-lo": {
      "$type": "color",
      "$value": "#225C4E5C",
      "$extensions": { "seaglass": { "dark": "#0000008C" } }
    },
    "carved-hi": {
      "$type": "color",
      "$value": "#FFFFFFF2",
      "$extensions": { "seaglass": { "dark": "#FFFFFF24" } }
    }
  }
}
